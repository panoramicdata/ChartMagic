@using System.Reflection
@using PanoramicData.ChartMagic.Models
@page "/"
@inject IJSRuntime JS

<PageTitle>ChartMagic</PageTitle>

<header class="page-header">
	<div>
		<h1>ChartMagic <span class="version">@Version</span></h1>
		<p class="lead">
			Charts rendered in your browser by <code>PanoramicData.ChartMagic</code>, running under
			WebAssembly. Every chart is generated from a <code>ChartSpecification</code> and
			inserted as inline SVG &mdash; there is no server and no image file.
		</p>
	</div>
	<div class="mode-picker" role="group" aria-label="Colour mode">
		@foreach (var mode in Modes)
		{
			<button type="button"
					class="mode-button @(mode.Value == _mode ? "active" : null)"
					aria-pressed="@(mode.Value == _mode ? "true" : "false")"
					@onclick="() => SetModeAsync(mode.Value)">
				@mode.Label
			</button>
		}
	</div>
</header>

<p class="notes">
	Each tab holds one sample: the chart, then the <code>ChartSpecification</code> properties it
	sets and the data behind it. Both are read from the specification that produced the chart, so
	they cannot drift from what you are looking at. Every chart is drawn on a deliberately
	translucent background, so the stripes showing through are the page.
</p>

<div class="status-key">
	<span class="badge working">Working</span> renders as intended
	<span class="badge partial">Partial</span> draws, but not everything asked for
	<span class="badge missing">Not implemented</span> draws nothing
</div>

<PDTabSet CssClass="samples" TabMinWidth="auto" TabMaxWidth="none">
	@foreach (var sample in _samples)
	{
		<PDTab Title="@sample.Title">
			<section class="sample">
				<h2>
					@sample.Title
					<span class="badge @BadgeClass(sample.Status)">@BadgeText(sample.Status)</span>
				</h2>
				<p class="notes">@sample.Notes</p>

				@{
					var view = View(sample);
				}

				<div class="sample-body">
					<div class="sample-chart">
						<div class="chart">
							<div class="light-only">@((MarkupString)view.LightSvg)</div>
							<div class="dark-only">@((MarkupString)view.DarkSvg)</div>
						</div>
					</div>

					<aside class="sample-detail">
						<h3>ChartSpecification</h3>
						@if (view.Settings.Count == 0)
						{
							<p class="notes">Nothing beyond the defaults.</p>
						}
						else
						{
							<table class="detail-table">
								<tbody>
									@foreach (var setting in view.Settings)
									{
										<tr>
											<th scope="row">@setting.Name</th>
											<td>@setting.Value</td>
										</tr>
									}
								</tbody>
							</table>
						}

						<h3>Series</h3>
						@foreach (var series in view.Series)
						{
							<p class="series-name">@series.Name</p>
							<table class="detail-table">
								<tbody>
									@foreach (var setting in series.Settings)
									{
										<tr>
											<th scope="row">@setting.Name</th>
											<td>@setting.Value</td>
										</tr>
									}
								</tbody>
							</table>
						}

						<h3>Data</h3>
						<table class="detail-table data-table">
							<thead>
								<tr>
									<th scope="col"></th>
									@foreach (var name in view.Data.SeriesNames)
									{
										<th scope="col">@name</th>
									}
								</tr>
							</thead>
							<tbody>
								@foreach (var row in view.Data.Rows)
								{
									<tr>
										<th scope="row">@row.Category</th>
										@foreach (var value in row.Values)
										{
											<td>@value</td>
										}
									</tr>
								}
							</tbody>
						</table>
					</aside>
				</div>
			</section>
		</PDTab>
	}
</PDTabSet>

@code {
	/// <summary>
	/// Everything a tab needs, computed once for the sample it belongs to.
	/// </summary>
	/// <remarks>
	/// The details are read before the SVGs are rendered, deliberately: rendering applies the
	/// theme colours to the specification, and those would otherwise show up in the property
	/// list as though the sample had asked for them.
	/// </remarks>
	private sealed record SampleView(
		IReadOnlyList<SettingRow> Settings,
		IReadOnlyList<SeriesRow> Series,
		DataGrid Data,
		string LightSvg,
		string DarkSvg);

	/// <summary>
	/// The version of the library that rendered these charts, from Nerdbank.GitVersioning.
	/// </summary>
	/// <remarks>
	/// Read from the rendering assembly rather than from this one: the useful question when
	/// looking at a chart is which ChartMagic drew it, not which demo displayed it. The build
	/// metadata after the plus sign is the commit, which is dropped - the version is there to
	/// orient the reader, not to identify a build exactly.
	/// </remarks>
	private static string Version { get; } = ReadVersion();

	private static string ReadVersion()
	{
		var informational = typeof(Chart).Assembly
			.GetCustomAttribute<AssemblyInformationalVersionAttribute>()
			?.InformationalVersion;

		if (informational is not { Length: > 0 })
		{
			return string.Empty;
		}

		var plus = informational.IndexOf('+', StringComparison.Ordinal);
		return plus < 0 ? informational : informational[..plus];
	}

	private static readonly (string Value, string Label)[] Modes =
	[
		("auto", "Auto"),
		("light", "Light"),
		("dark", "Dark")
	];

	private IReadOnlyList<ChartSample> _samples = [];
	private readonly Dictionary<string, SampleView> _views = [];
	private string _mode = "auto";

	protected override void OnInitialized()
		// Held in a field: the gallery builds fresh specifications on every access, and the view
		// cache is keyed against these instances.
		=> _samples = SampleCharts.All;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		// The mode was already applied to the document by the boot script; this is only to show
		// the right button as selected.
		var stored = await JS.InvokeAsync<string>("chartMagicDemo.getTheme");
		if (stored != _mode)
		{
			_mode = stored;
			StateHasChanged();
		}
	}

	private async Task SetModeAsync(string mode)
	{
		_mode = mode;
		await JS.InvokeVoidAsync("chartMagicDemo.setTheme", mode);
	}

	/// <summary>
	/// Builds a tab's content on first view and keeps it, so switching tabs does not re-render
	/// every chart and re-reflect every specification.
	/// </summary>
	private SampleView View(ChartSample sample)
	{
		if (_views.TryGetValue(sample.Title, out var existing))
		{
			return existing;
		}

		var settings = SampleDetails.ChartSettings(sample.Specification);
		var series = SampleDetails.SeriesSettings(sample.Specification);
		var data = SampleDetails.Data(sample.Specification);

		var view = new SampleView(
			settings,
			series,
			data,
			SampleCharts.ToSvg(sample.Specification, ChartTheme.Light),
			SampleCharts.ToSvg(sample.Specification, ChartTheme.Dark));

		_views[sample.Title] = view;
		return view;
	}

	private static string BadgeClass(SampleStatus status) => status switch
	{
		SampleStatus.Working => "working",
		SampleStatus.Partial => "partial",
		_ => "missing"
	};

	private static string BadgeText(SampleStatus status) => status switch
	{
		SampleStatus.Working => "Working",
		SampleStatus.Partial => "Partial",
		_ => "Not implemented"
	};
}
