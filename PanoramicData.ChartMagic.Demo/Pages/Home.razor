@page "/"
@using System.Reflection
@using PanoramicData.ChartMagic.Models
@inject IJSRuntime JS

<PageTitle>ChartMagic</PageTitle>

<header class="page-header">
	<div>
		<h1>ChartMagic <span class="version">@Version</span></h1>
		<p class="lead">
			Charts rendered in your browser by <code>PanoramicData.ChartMagic</code>, running under
			WebAssembly. Every chart is generated from a <code>ChartSpecification</code> and
			inserted as inline SVG &mdash; there is no server and no image file.
		</p>
	</div>
	<div class="mode-picker" role="group" aria-label="Colour mode">
		@foreach (var mode in Modes)
		{
			<button type="button"
					class="mode-button @(mode.Value == _mode ? "active" : null)"
					aria-pressed="@(mode.Value == _mode ? "true" : "false")"
					@onclick="() => SetModeAsync(mode.Value)">
				@mode.Label
			</button>
		}
	</div>
</header>

<p class="notes">
	Each tab holds one sample. Every property of the <code>ChartSpecification</code> is listed
	beside the chart and can be edited: the chart redraws as you change it. Properties still at
	their default are dimmed, so what the sample actually sets stands out. <strong>Reset</strong>
	puts the sample back.
</p>

<div class="status-key">
	<span class="badge working">Working</span> renders as intended
	<span class="badge partial">Partial</span> draws, but not everything asked for
	<span class="badge missing">Not implemented</span> draws nothing
</div>

<PDTabSet CssClass="samples" TabMinWidth="auto" TabMaxWidth="none">
	@foreach (var sample in _samples)
	{
		<PDTab Title="@sample.Title">
			@{
				var state = StateFor(sample);
			}
			<section class="sample">
				<h2>
					@sample.Title
					<span class="badge @BadgeClass(sample.Status)">@BadgeText(sample.Status)</span>
					<button type="button" class="reset-button" @onclick="() => Reset(sample.Title)">Reset</button>
					@if (state.IsEdited)
					{
						<span class="edited">edited</span>
					}
				</h2>
				<p class="notes">@sample.Notes</p>

				<div class="sample-body">
					<div class="sample-chart">
						<div class="chart">
							<div class="light-only">@((MarkupString)LightSvg(state))</div>
							<div class="dark-only">@((MarkupString)DarkSvg(state))</div>
						</div>
					</div>

					<aside class="sample-detail">
						@*
							One table for the whole specification, with colspan heading rows rather
							than a table per group: separate tables size their columns
							independently, so the names and values stop lining up between them.
						*@
						<table class="detail-table editor-table">
							<tbody>
								@{
									var group = string.Empty;
								}
								@foreach (var property in state.Editors)
								{
									@if (property.Group != group)
									{
										group = property.Group;
										<tr class="section">
											<th colspan="2">@GroupLabel(group)</th>
										</tr>
									}

									<tr class="@(property.IsDefault ? "is-default" : null)">
										<th scope="row">@property.Name</th>
										<td>
											@switch (property.Kind)
											{
												case EditorKind.Boolean:
													<input type="checkbox"
														   checked="@(SpecificationEditor.Read(state.Specification, property.Name) == "true")"
														   @onchange="e => Set(state, property.Name, e.Value?.ToString()?.ToLowerInvariant())" />
													break;

												case EditorKind.Enumeration:
													<select value="@SpecificationEditor.Read(state.Specification, property.Name)"
															@onchange="e => Set(state, property.Name, e.Value?.ToString())">
														@foreach (var option in property.Options)
														{
															<option value="@option">@(option.Length == 0 ? "(none)" : option)</option>
														}
													</select>
													break;

												case EditorKind.Number:
													<input type="number" step="any"
														   value="@SpecificationEditor.Read(state.Specification, property.Name)"
														   @onchange="e => Set(state, property.Name, e.Value?.ToString())" />
													break;

												case EditorKind.ReadOnly:
													<span class="read-only">@SpecificationEditor.Read(state.Specification, property.Name)</span>
													break;

												default:
													<input type="text"
														   value="@SpecificationEditor.Read(state.Specification, property.Name)"
														   @onchange="e => Set(state, property.Name, e.Value?.ToString())" />
													break;
											}
										</td>
									</tr>
								}
							</tbody>
						</table>

						@*
							The data keeps its own table: it has a column per series rather than a
							name and a value, so folding it into the one above would align nothing.
						*@
						<table class="detail-table data-table">
							<tbody>
								<tr class="section">
									<th colspan="@(state.Data.SeriesNames.Count + 1)">Data</th>
								</tr>
								<tr>
									<th></th>
									@foreach (var name in state.Data.SeriesNames)
									{
										<th scope="col">@name</th>
									}
								</tr>
								@foreach (var row in state.Data.Rows)
								{
									<tr>
										<th scope="row">@row.Category</th>
										@foreach (var value in row.Values)
										{
											<td>@value</td>
										}
									</tr>
								}
							</tbody>
						</table>
					</aside>
				</div>
			</section>
		</PDTab>
	}
</PDTabSet>

@code {
	/// <summary>
	/// A sample's live state: the specification being edited, and the renders of it.
	/// </summary>
	/// <remarks>
	/// The renders are held until something changes rather than recomputed on every re-render:
	/// a single keystroke in one field would otherwise redraw every chart on the page.
	/// </remarks>
	private sealed class SampleState
	{
		public required ChartSpecification Specification { get; set; }

		public bool IsEdited { get; set; }

		public string? Light { get; set; }

		public string? Dark { get; set; }

		public IReadOnlyList<PropertyEditor> Editors { get; set; } = [];

		public DataGrid Data { get; set; } = new([], []);

		public void Invalidate()
		{
			Light = null;
			Dark = null;
			Editors = SpecificationEditor.Describe(Specification);
			Data = SampleDetails.Data(Specification);
		}
	}

	private static readonly (string Value, string Label)[] Modes =
	[
		("auto", "Auto"),
		("light", "Light"),
		("dark", "Dark")
	];

	/// <summary>
	/// The version of the library that rendered these charts, from Nerdbank.GitVersioning.
	/// </summary>
	/// <remarks>
	/// Read from the rendering assembly rather than from this one: the useful question when
	/// looking at a chart is which ChartMagic drew it. The build metadata after the plus sign is
	/// dropped - the version is there to orient the reader, not to identify a build exactly.
	/// </remarks>
	private static string Version { get; } = ReadVersion();

	private IReadOnlyList<ChartSample> _samples = [];
	private readonly Dictionary<string, SampleState> _state = [];
	private string _mode = "auto";

	protected override void OnInitialized() => _samples = SampleCharts.All;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		// The mode was already applied to the document by the boot script; this only lights the
		// right button.
		var stored = await JS.InvokeAsync<string>("chartMagicDemo.getTheme");
		if (stored != _mode)
		{
			_mode = stored;
			StateHasChanged();
		}
	}

	private async Task SetModeAsync(string mode)
	{
		_mode = mode;
		await JS.InvokeVoidAsync("chartMagicDemo.setTheme", mode);
	}

	private SampleState StateFor(ChartSample sample)
	{
		if (_state.TryGetValue(sample.Title, out var existing))
		{
			return existing;
		}

		var state = new SampleState { Specification = sample.Specification };
		state.Invalidate();
		_state[sample.Title] = state;
		return state;
	}

	private static string LightSvg(SampleState state)
		=> state.Light ??= SampleCharts.ToSvg(state.Specification, ChartTheme.Light);

	private static string DarkSvg(SampleState state)
		=> state.Dark ??= SampleCharts.ToSvg(state.Specification, ChartTheme.Dark);

	/// <summary>
	/// Applies an edit and redraws. A value that will not parse is ignored, because half-typed
	/// input is normal when the chart is redrawing as you type.
	/// </summary>
	private static void Set(SampleState state, string name, string? value)
	{
		if (!SpecificationEditor.Write(state.Specification, name, value))
		{
			return;
		}

		state.IsEdited = true;
		state.Invalidate();
	}

	/// <summary>
	/// Puts a sample back to the specification it shipped with, by rebuilding it.
	/// </summary>
	private void Reset(string title)
	{
		var sample = SampleCharts.All.FirstOrDefault(s => s.Title == title);
		if (sample is null)
		{
			return;
		}

		var state = new SampleState { Specification = sample.Specification };
		state.Invalidate();
		_state[title] = state;
	}

	/// <summary>
	/// Group names are prefixed with a sort key so the groups appear in layout order rather than
	/// alphabetically; the key is not shown.
	/// </summary>
	private static string GroupLabel(string group) => group.Length > 2 ? group[2..] : group;

	private static string ReadVersion()
	{
		var informational = typeof(Chart).Assembly
			.GetCustomAttribute<AssemblyInformationalVersionAttribute>()
			?.InformationalVersion;

		if (informational is not { Length: > 0 })
		{
			return string.Empty;
		}

		var plus = informational.IndexOf('+', StringComparison.Ordinal);
		return plus < 0 ? informational : informational[..plus];
	}

	private static string BadgeClass(SampleStatus status) => status switch
	{
		SampleStatus.Working => "working",
		SampleStatus.Partial => "partial",
		_ => "missing"
	};

	private static string BadgeText(SampleStatus status) => status switch
	{
		SampleStatus.Working => "Working",
		SampleStatus.Partial => "Partial",
		_ => "Not implemented"
	};
}
